#!/bin/sh

APP_PATH="$HOME/Applications/ZshrcEditor.app"
FALLBACK_APP="/private/tmp/ZshrcEditorProjectDerivedData/Build/Products/Debug/ZshrcEditor.app"

if [ -d "$APP_PATH" ]; then
  exec open "$APP_PATH"
fi

if [ -d "$FALLBACK_APP" ]; then
  exec open "$FALLBACK_APP"
fi

printf '%s\n' "ZshrcEditor.app not found. Build or install the app first." >&2
exit 1
